# Build-time settings for the shell. Copy to .env.local for local builds.
# Real values for the published site live in GitHub Actions repository variables
# (PIFI_SIGNAL_URL, PIFI_ICE_SERVERS), not in the repo.

# The signaling server (wss:// in production). Never taken from the page URL or a QR code.
VITE_SIGNAL_URL=ws://localhost:8080/ws
# JSON array of STUN/TURN URLs. TURN credentials must NOT go here (they would be public).
VITE_ICE_SERVERS=["stun:stun.l.google.com:19302"]
# Base path. "/" for local use; "/<repo>/" for a GitHub project site (the workflow sets this).
VITE_BASE=/
