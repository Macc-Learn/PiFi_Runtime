{
  "name": "pifi",
  "version": "0.1.0",
  "private": true,
  "description": "PiFi: a small runtime that manages apps on a Raspberry Pi",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test --test-concurrency=1 \"packages/*/dist/test/*.test.js\" && npm run -s test -w @pifi/shell",
    "demo:register": "node scripts/register-echo.mjs",
    "signal-server": "node packages/server/dist/src/index.js",
    "signal-testclient": "node packages/signal-testclient/dist/src/testclient.js",
    "build:shell": "npm run -s build -w @pifi/shell && node examples/echo-app/frontend/build.mjs packages/shell/dist/examples/echo",
    "typecheck:shell": "tsc -p packages/shell/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
