{
  "name": "pifi",
  "version": "0.1.0",
  "private": true,
  "description": "PiFi: a small runtime that manages apps on a Raspberry Pi",
  "type": "module",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test --test-concurrency=1 \"packages/runtime/dist/test/*.test.js\"",
    "demo:register": "node scripts/register-echo.mjs"
  }
}
